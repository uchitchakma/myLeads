# Environment configuration for Autonomous Client Acquisition Engine

# 1. AI API Key (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Google PageSpeed API Key (Optional - works without key for up to 25k requests/day)
PAGESPEED_API_KEY=

# 3. Email Dispatcher / SMTP (For automated email outreach)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDER_NAME="Your Name | Web Architect"
SENDER_EMAIL=your-email@gmail.com

# 4. Telegram Notification Bot (Optional - sends instant alerts when clients reply)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
